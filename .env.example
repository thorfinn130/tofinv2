DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
PREFIX=,
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
SESSION_SECRET=your_session_secret_here

# Used by the GIF maker (,gif / ,caption gif / /gif).
# CLOUDINARY_CLOUD_NAME alone lets video-to-GIF conversion run on Cloudinary
# instead of local ffmpeg (faster, lighter on the server).
# Also set CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET (free on any Cloudinary
# account, under Console > Dashboard) to get a permanent, non-expiring link
# for every GIF the bot makes — without these two, generated GIFs only live
# on Discord's own attachment link, which can go dead if reused later outside
# the original message.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

